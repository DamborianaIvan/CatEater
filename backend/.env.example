# Variables obligatorias
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<secreto-largo-y-aleatorio>
PORT=5000

# URL pública del backend (Swagger y clientes externos)
API_URL=http://localhost:5000

# URL pública del frontend (recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# EmailJS (recuperación de contraseña)
EMAILJS_SERVICE_ID=service_xxx
EMAILJS_TEMPLATE_ID=template_xxx
EMAILJS_USER_ID=public_key_xxx
